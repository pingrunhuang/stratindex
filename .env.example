# Copy to .env and fill in (never commit .env)
PORT=5055
STRATINDEX_ADMIN_PASSWORD=change-me
STRATINDEX_SECRET_KEY=long-random-string
STRATINDEX_INGEST_TOKEN=long-random-bot-token
STRATINDEX_PUBLIC_BASE_URL=https://stratindex.frank.com
# Optional host bind path for SQLite (compose default: ./data)
# STRATINDEX_DATA_HOST=./data
# Race submission emails (approve/reject). Leave SMTP_HOST empty to skip sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StratIndex <noreply@example.com>
# SMTP_TLS: starttls (port 587) | ssl (port 465) | none
SMTP_TLS=starttls
